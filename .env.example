# Copy to .env.local for local development. Never commit real values.
# Everything runs in mock mode until the relevant keys are set.

# --- Mode -------------------------------------------------------------------
# true = force every integration to its mock (in-memory DB, no external calls)
MOCK_MODE=true
# Public URL of the app (used in email links and webhook URLs)
APP_BASE_URL=http://localhost:3000

# --- Voice: Vaani (app.vaanivoice.ai) ---------------------------------------
VAANI_API_KEY=
# Secret used to verify Vaani webhooks (X-Vaani-Signature) and the agent's tool calls
VAANI_WEBHOOK_SECRET=

# --- Calendar: Cal.com --------------------------------------------------------
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_WEBHOOK_SECRET=

# --- CRM: HubSpot (private app token) ----------------------------------------
HUBSPOT_TOKEN=
# Optional: makes deal links clickable in the dashboard and emails
HUBSPOT_PORTAL_ID=
# Optional overrides if your pipeline differs from HubSpot's default
# HUBSPOT_PIPELINE=default
# HUBSPOT_STAGE_OPEN=appointmentscheduled
# HUBSPOT_STAGE_LOST=closedlost

# --- Email: Resend ------------------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Aangan Studio <enquiries@aanganstudio.in>"
FROM_EMAIL=
DESIGNER_EMAIL=
FRONT_DESK_EMAIL=
RESEND_WEBHOOK_SECRET=

# --- App secrets --------------------------------------------------------------
# Long random string; signs Acknowledge links and dashboard sessions
ACK_TOKEN_SECRET=
DASHBOARD_PASSWORD=
# Long random string; Vercel sends it to /api/jobs/retry as a Bearer token
CRON_SECRET=

# --- Database: Neon Postgres ---------------------------------------------------
# Pooled connection string from the Neon console (Connect → "Pooled connection")
DATABASE_URL=

# --- LLM: transcript extraction -----------------------------------------------
# Google Gemini API key (aistudio.google.com → Get API key)
LLM_API_KEY=
# Optional: "gemini" (default) or "anthropic"
# LLM_PROVIDER=gemini
# Optional: defaults to gemini-3.8-flash (or claude-opus-5-5 with LLM_PROVIDER=anthropic)
# LLM_MODEL=gemini-3.8-flash

# --- Optional cost settings for the cost panel -------------------------------
# VAANI_USD_PER_CREDIT=
# VOICE_USD_PER_MINUTE=
# INR_PER_USD=84
